# Public browser configuration only. Copy to client.env and customize as needed.
# Compose selects the STACK_ENVIRONMENT preset and the stack API URL.
# These examples are mainnet; use Sepolia providers for prerelease.
# Both primary and backup Starknet providers must serve RPC v0.10.
# Use the provider-specific v0.10 URL; URL formats differ between providers.
# Never put private keys or server credentials here.
REACT_APP_STARKNET_PROVIDER=https://your-public-mainnet-rpc.example
# REACT_APP_STARKNET_PROVIDERBACKUP=https://your-backup-mainnet-rpc.example
REACT_APP_ETHEREUM_PROVIDER=https://your-public-ethereum-rpc.example
REACT_APP_API_IPFS=https://your-public-ipfs-gateway.example/ipfs
REACT_APP_API_AVNU=https://your-public-avnu-api.example
