integration_test() {
  [ "$#" -eq 1 ] || die "Usage: ./stack integration-test IMAGE@sha256:DIGEST"
  require_command docker
  require_command jq
  require_command openssl
  load_env
  export INFLUENCE_SERVER_IMAGE="$1"
  validate_image_pin INFLUENCE_SERVER_IMAGE
  validate_image_pin MONGO_IMAGE
  validate_image_pin REDIS_IMAGE
  validate_image_pin ELASTICSEARCH_IMAGE
  compose_files
  validate_application_images
  local fingerprint
  fingerprint="$(deployment_fingerprint)"

  local integration_secrets_dir
  integration_secrets_dir="$(mktemp -d)"
  chmod 700 "$integration_secrets_dir"
  umask 077
  openssl rand -hex 32 > "${integration_secrets_dir}/mongo_root_password"
  openssl rand -hex 32 > "${integration_secrets_dir}/mongo_app_password"
  openssl rand -hex 32 > "${integration_secrets_dir}/redis_password"
  openssl rand -hex 32 > "${integration_secrets_dir}/elasticsearch_password"
  local elasticsearch_password
  local mongo_password
  local redis_password
  mongo_password="$(<"${integration_secrets_dir}/mongo_app_password")"
  redis_password="$(<"${integration_secrets_dir}/redis_password")"
  elasticsearch_password="$(<"${integration_secrets_dir}/elasticsearch_password")"
  printf 'mongodb://%s:%s@mongo:27017/%s?authSource=%s\n' \
    "${MONGO_APP_USERNAME:-influence}" "$mongo_password" \
    "${MONGO_DATABASE:-influence}" "${MONGO_DATABASE:-influence}" \
    > "${integration_secrets_dir}/mongo_url"
  printf 'redis://:%s@redis:6379\n' "$redis_password" \
    > "${integration_secrets_dir}/redis_url"
  printf 'http://elastic:%s@elasticsearch:9200\n' "$elasticsearch_password" \
    > "${integration_secrets_dir}/elasticsearch_url"
  printf '%s\n' 'https://ethereum.invalid' \
    > "${integration_secrets_dir}/alchemy_influence_ethereum_http_url"
  export INTEGRATION_SECRETS_DIR="$integration_secrets_dir"

  COMPOSE_ARGS=(-p "influence-integration-$$" "${COMPOSE_ARGS[@]}" -f "${STACK_ROOT}/compose.smoke.yaml")
  trap 'compose down --volumes --remove-orphans >/dev/null 2>&1 || true; rm -rf -- "$integration_secrets_dir"' EXIT

  info "Pulling the selected server digest and pinned datastore images"
  compose --profile tools pull influence-tools mongo redis elasticsearch
  info "Starting temporary MongoDB, Redis, and Elasticsearch"
  compose up -d mongo redis elasticsearch
  wait_for_health mongo
  wait_for_health redis
  wait_for_health elasticsearch 600

  local script
  script=$(cat <<'EOF'
require('module-alias/register');
const { mongoose } = require('@common/storage/db');
const redis = require('@common/lib/redis');
const { client: elasticsearch } = require('@common/storage/elasticsearch');
(async () => {
  await mongoose.connection.asPromise();
  await mongoose.connection.db.admin().ping();
  await redis.set('influence-stack-smoke', 'ok', 10_000);
  if (await redis.get('influence-stack-smoke') !== 'ok') throw new Error('Redis round trip failed');
  const elasticsearchInfo = await elasticsearch.info();
  console.log(JSON.stringify({
    mongo: 'ok',
    redis: 'ok',
    elasticsearch: elasticsearchInfo.version.number
  }));
  await redis.delete('influence-stack-smoke');
  await redis.disconnect();
  await elasticsearch.close();
  await mongoose.disconnect();
})().catch((error) => { console.error(error); process.exit(1); });
EOF
)

  info "Testing authenticated connections from the selected Influence image"
  compose --profile tools run --rm --no-deps influence-tools -e "$script"
  compose down --volumes --remove-orphans
  rm -rf -- "$integration_secrets_dir"
  trap - EXIT
  record_integration_test "$INFLUENCE_SERVER_IMAGE" "$fingerprint"
  info "Integration test passed for $INFLUENCE_SERVER_IMAGE"
  info "Disposable credentials, containers, and volumes were removed"
}

prepare_juno() {
  [ "$#" -eq 0 ] || die "Usage: ./stack prepare-juno"
  [ ! -e "${STATE_DIR}/bootstrap-complete" ] \
    || die "This stack is already bootstrapped; use restart-juno or upgrade-juno"
  local command
  for command in curl docker jq sha256sum tar zstd; do
    require_command "$command"
  done
  load_env
  validate_data_root
  validate_juno_configuration
  export HOST_UID="${HOST_UID:-$(id -u)}"
  export HOST_GID="${HOST_GID:-$(id -g)}"
  COMPOSE_ARGS=(--env-file "$ENV_FILE" -f "${STACK_ROOT}/compose.juno.yaml")
  if [ ! -d "${DATA_ROOT}/juno-data" ] || [ ! -d "${DATA_ROOT}/downloads" ]; then
    die "Persistent directories are missing; run ./stack prepare-host first"
  fi
  compose config --quiet
  install_juno_snapshot
  compose up -d --no-deps juno
  wait_for_juno
  info "Juno is ready and will keep running. Obtain a consistent Mongo dump, then run bootstrap."
}

bootstrap_stack() {
  local mongo_dump=""
  local resume_after_restore=0
  local resume_after_indexing=0
  local rebuild_packed_cache=0
  while [ "$#" -gt 0 ]; do
    case "$1" in
      --mongo-dump)
        [ "$#" -ge 2 ] || die "--mongo-dump requires a path"
        mongo_dump="$2"
        shift 2
        ;;
      --resume-after-restore)
        resume_after_restore=1
        shift
        ;;
      --resume-after-indexing)
        resume_after_indexing=1
        shift
        ;;
      --rebuild-packed-cache)
        rebuild_packed_cache=1
        shift
        ;;
      *) die "Unknown bootstrap option: $1" ;;
    esac
  done

  if [ "$resume_after_indexing" -eq 1 ]; then
    [ -z "$mongo_dump" ] && [ "$resume_after_restore" -eq 0 ] && [ "$rebuild_packed_cache" -eq 0 ] \
      || die "--resume-after-indexing cannot be combined with other bootstrap modes or cache rebuilding"
  elif [ "$resume_after_restore" -eq 1 ]; then
    [ -z "$mongo_dump" ] || die "Use either --mongo-dump or --resume-after-restore, not both"
  else
    [ -n "$mongo_dump" ] || die "A Mongo dump is required for a fresh production bootstrap"
  fi
  [ ! -e "${STATE_DIR}/bootstrap-complete" ] || die "This stack is already bootstrapped"
  require_command curl
  require_command docker
  require_command jq
  require_command openssl
  require_command sha256sum
  require_command tar
  require_command zstd
  load_env
  refresh_connection_secrets
  validate_data_root
  validate_configuration
  compose_files
  validate_application_images
  require_integration_test
  [ -d "${DATA_ROOT}/juno-data" ] || die "Persistent directories are missing; run ./stack prepare-host first"
  [ -d "${DATA_ROOT}/backups" ] || die "Persistent directories are missing; run ./stack prepare-host first"

  if [ "$resume_after_indexing" -eq 0 ]; then
    install_juno_snapshot
  fi
  info "Starting persistent services"
  compose up -d mongo redis elasticsearch juno
  wait_for_health mongo
  wait_for_health redis
  wait_for_health elasticsearch 600
  if [ "$resume_after_restore" -eq 1 ] || [ "$resume_after_indexing" -eq 1 ]; then
    info "Resuming with existing MongoDB data; skipping archive restore"
  else
    restore_mongo "$mongo_dump"
  fi

  local restored_metrics
  local restored_starknet_checkpoint
  restored_metrics="$(mongo_metrics)"
  jq -e '
    (.ethereumCheckpoint | type == "number" and . >= 0)
    and (.starknetCheckpoint | type == "number" and . >= 0)
    and (.entities | type == "number" and . > 0)
    and (.packedLotCacheEntries | type == "number")
  ' <<<"$restored_metrics" >/dev/null \
    || die "Mongo dump is missing Influence entities or chain checkpoints"
  restored_starknet_checkpoint="$(jq -r '.starknetCheckpoint' <<<"$restored_metrics")"
  if [ "$(jq -r '.packedLotCacheEntries' <<<"$restored_metrics")" -eq 0 ]; then
    [ "$resume_after_indexing" -eq 0 ] || die "Packed lot cache is missing; cannot resume after indexing"
    info "The restored dump has no packed lot cache; scheduling a rebuild"
    rebuild_packed_cache=1
  fi

  wait_for_juno

  if (( $(juno_block) < restored_starknet_checkpoint )); then
    die "Juno synchronized below the restored MongoDB checkpoint"
  fi
  juno_has_block "$restored_starknet_checkpoint" \
    || die "Juno does not retain the restored MongoDB checkpoint; use a full or compatible snapshot"

  if [ "$resume_after_indexing" -eq 1 ]; then
    info "Preserving existing Elasticsearch indices and queue"
    validate_existing_search
  else
    prepare_search_indices
  fi
  compose --profile indexer up -d influence-indexer

  if [ "$rebuild_packed_cache" -eq 1 ]; then
    info "Rebuilding packed lot cache"
    compose --profile tools run --rm --no-deps influence-tools \
      ./bin/preloadLotData.js --initEmpty --setLeaseStatus
  fi

  info "Starting processors, chain retrievers, and auditors"
  compose --profile indexer --profile auditor up -d \
    influence-event-processor \
    influence-ethereum-event-retriever \
    influence-starknet-event-retriever \
    influence-event-auditor \
    influence-agreement-auditor
  wait_for_convergence
  wait_for_required_workers

  info "Starting API and TLS edge"
  compose --profile indexer --profile auditor up -d influence-server caddy
  wait_for_health influence-server 300
  date -u +%Y-%m-%dT%H:%M:%SZ > "${STATE_DIR}/bootstrap-complete"
  info "Production stack bootstrap complete"
}

validate_existing_search() {
  compose --profile tools run --rm --no-deps influence-tools -e '
require("module-alias/register");
const { client } = require("@common/storage/elasticsearch");
const schemas = require("@common/storage/elasticsearch/schemas");
(async () => {
  for (const type of Object.keys(schemas)) {
    const result = await client.indices.getAlias({ name: type });
    const indices = result.body || result;
    if (!Object.keys(indices).some(index => index.startsWith(`${type}_v`))) {
      throw new Error(`Missing search index for ${type}`);
    }
  }
  process.exit(0);
})().catch(error => { console.error(error); process.exit(1); });'
}

prepare_search_indices() {
  info "Creating and populating Elasticsearch indices"
  reset_elasticsearch
  compose --profile tools run --rm --no-deps influence-tools ./bin/elasticsearch.js initialSetup
  # The quoted script expands inside Elasticsearch, not in this operator shell.
  # shellcheck disable=SC2016
  compose exec -T elasticsearch sh -ec '
    password="$(tr -d "\r\n" < /run/secrets/elasticsearch_password)"
    curl -fsS -u "elastic:${password}" -X PUT \
      -H "content-type: application/json" \
      --data "{\"index\":{\"number_of_replicas\":0}}" \
      "http://localhost:9200/_all/_settings"
  ' >/dev/null
  compose --profile tools run --rm --no-deps influence-tools ./bin/elasticsearch.js reIndex
}

