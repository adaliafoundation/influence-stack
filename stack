#!/usr/bin/env bash
set -Eeuo pipefail

STACK_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
ENV_FILE="${STACK_ROOT}/.env"
STATE_DIR="${STACK_ROOT}/.state"
INTEGRATION_RECEIPT="${STATE_DIR}/server-integration-test"

die() {
  echo "Error: $*" >&2
  exit 1
}

info() {
  echo "==> $*"
}

usage() {
  cat <<'EOF'
Usage: ./stack <command> [options]

Commands:
  init                  Create local configuration and service secrets
  install-secret NAME [PATH]
                        Prompt for, or import, a provider/application secret
  prepare-host          Create and permission persistent data directories
  install-signer-key    Install the Starknet signer key with protected permissions
  config                Validate and render the production Compose config
  integration-test IMAGE
                        Test an immutable server image with disposable local stores
  prepare-juno          Seed and synchronize Juno before obtaining a Mongo dump
  bootstrap             Restore a Mongo dump, seed Juno, rebuild search, and catch up
  deploy                Start an already-bootstrapped production stack
  update                Pull current images and recreate the production stack
  restart-juno          Gracefully restart Juno and gate the Starknet retriever
  upgrade-juno          Safely apply a changed immutable Juno image pin
  status                Show service and convergence status
  logs [service]        Follow all logs or one Compose service
  backup                Upload an encrypted MongoDB and configuration backup
  backup-init           Initialize the configured off-host Restic repository
  backup-repository ARGS
                        Run Restic commands (snapshots, check, restore, etc.)

Bootstrap options:
  --mongo-dump PATH     Compressed mongodump archive for a fresh deployment
  --resume-after-restore
                        Validate existing Mongo data and continue without restoring
  --resume-after-indexing
                        Preserve existing data and search indices; finish catch-up
  --rebuild-packed-cache
                        Recompute packed lot data after restoring MongoDB
EOF
}

require_command() {
  command -v "$1" >/dev/null 2>&1 || die "Required command not found: $1"
}

load_env() {
  [ -f "$ENV_FILE" ] || die "Missing .env. Run ./stack init first."
  local line
  local key
  local value
  while IFS= read -r line || [ -n "$line" ]; do
    line="${line%$'\r'}"
    case "$line" in
      ''|'#'*) continue ;;
      *=*) ;;
      *) die "Invalid line in .env: $line" ;;
    esac

    key="${line%%=*}"
    value="${line#*=}"
    [[ "$key" =~ ^[A-Za-z_][A-Za-z0-9_]*$ ]] || die "Invalid variable name in .env: $key"
    if [[ "$value" =~ ^\".*\"$ ]] || [[ "$value" =~ ^\'.*\'$ ]]; then
      value="${value:1:${#value}-2}"
    fi
    export "$key=$value"
  done < "$ENV_FILE"
  prepare_optional_secret_paths
}

compose_files() {
  export HOST_UID="${HOST_UID:-$(id -u)}"
  export HOST_GID="${HOST_GID:-$(id -g)}"
  COMPOSE_ARGS=(--env-file "$ENV_FILE" -f "${STACK_ROOT}/compose.yaml")
  if [ "${ENABLE_PROVISIONER:-0}" = "1" ]; then
    COMPOSE_ARGS+=(-f "${STACK_ROOT}/compose.provisioner.yaml")
  fi
}

compose() {
  docker compose "${COMPOSE_ARGS[@]}" "$@"
}

secret_file() {
  printf '%s/secrets/%s' "$STACK_ROOT" "$1"
}

prepare_optional_secret_paths() {
  local name
  local variable
  while read -r variable name; do
    unset "$variable"
    if [ -s "$(secret_file "$name")" ]; then
      export "$variable=/run/secrets/$name"
    fi
  done <<'EOF'
ARGENT_API_KEY_FILE argent_api_key
IPFS_RPC_AUTHORIZATION_FILE ipfs_rpc_authorization
OPEN_SEA_API_KEY_FILE open_sea_api_key
SENDGRID_API_KEY_FILE sendgrid_api_key
STRIPE_SECRET_KEY_FILE stripe_secret_key
STRIPE_WEBHOOK_SECRET_FILE stripe_webhook_secret
AVNU_PAYMASTER_API_KEY_FILE avnu_paymaster_api_key
BANXA_API_KEY_FILE banxa_api_key
BANXA_WEBHOOK_API_KEY_FILE banxa_webhook_api_key
BANXA_WEBHOOK_SECRET_FILE banxa_webhook_secret
EOF
}

generate_secret() {
  local destination
  destination="$(secret_file "$1")"
  if [ ! -s "$destination" ]; then
    umask 077
    openssl rand -hex 32 > "$destination"
  fi
  chmod 600 "$destination"
}

write_derived_secret() {
  local destination
  local temporary
  destination="$(secret_file "$1")"
  temporary="$(mktemp "${destination}.XXXXXX")"
  printf '%s\n' "$2" > "$temporary"
  chmod 600 "$temporary"
  mv "$temporary" "$destination"
}

refresh_connection_secrets() {
  local elasticsearch_password
  local mongo_password
  local name
  local redis_password
  for name in mongo_app_password redis_password elasticsearch_password; do
    [ -s "$(secret_file "$name")" ] \
      || die "Missing service secret: $name (run ./stack init first)"
  done
  mongo_password="$(tr -d '\r\n' < "$(secret_file mongo_app_password)")"
  redis_password="$(tr -d '\r\n' < "$(secret_file redis_password)")"
  elasticsearch_password="$(tr -d '\r\n' < "$(secret_file elasticsearch_password)")"
  case "${MONGO_APP_USERNAME:-influence}${MONGO_DATABASE:-influence}${mongo_password}${redis_password}${elasticsearch_password}" in
    *[!A-Za-z0-9._~-]*) die "Database names, users, and generated passwords must be URL-safe" ;;
  esac
  write_derived_secret mongo_url \
    "mongodb://${MONGO_APP_USERNAME:-influence}:${mongo_password}@mongo:27017/${MONGO_DATABASE:-influence}?authSource=${MONGO_DATABASE:-influence}"
  write_derived_secret redis_url "redis://:${redis_password}@redis:6379"
  write_derived_secret elasticsearch_url \
    "http://elastic:${elasticsearch_password}@elasticsearch:9200"
}

ensure_secret_file() {
  local destination
  destination="$(secret_file "$1")"
  if [ ! -e "$destination" ]; then
    umask 077
    : > "$destination"
  fi
  chmod 600 "$destination"
}

migrate_env_secret() {
  local variable="$1"
  local name="$2"
  local value="${!variable:-}"
  local destination
  destination="$(secret_file "$name")"

  if [ -n "$value" ] && [ ! -s "$destination" ]; then
    umask 077
    printf '%s' "$value" > "$destination"
  fi
  ensure_secret_file "$name"
  if grep -q "^${variable}=" "$ENV_FILE"; then
    replace_env_value "$variable" ""
  fi
}

validate_secret_file() {
  local name="$1"
  local destination
  local permissions
  destination="$(secret_file "$name")"
  [ -s "$destination" ] || { echo "Secret required: $name (run ./stack install-secret $name)" >&2; return 1; }
  permissions="$(file_permissions "$destination")"
  case "$permissions" in
    400|600) ;;
    *) echo "Secret must be owner-only (mode 0400 or 0600): $destination" >&2; return 1 ;;
  esac
}

validate_image_pin() {
  local variable="$1"
  local value="${!variable:-}"
  [[ "$value" =~ ^[A-Za-z0-9._:/-]+@sha256:[0-9a-f]{64}$ ]] \
    || die "$variable must be pinned to an immutable sha256 digest"
  [[ ! "$value" =~ @sha256:0{64}$ ]] \
    || die "$variable still contains the example digest"
}

validate_application_images() {
  local rendered
  rendered="$(compose --profile indexer --profile auditor --profile tools config --format json)"
  jq -e --arg image "$INFLUENCE_SERVER_IMAGE" '
    [
      .services["influence-server"],
      .services["influence-indexer"],
      .services["influence-ethereum-event-retriever"],
      .services["influence-starknet-event-retriever"],
      .services["influence-event-processor"],
      .services["influence-event-auditor"],
      .services["influence-agreement-auditor"],
      .services["influence-tools"]
    ] | all(.image == $image)
  ' <<<"$rendered" >/dev/null \
    || die "Every Influence service must use INFLUENCE_SERVER_IMAGE"
}

deployment_fingerprint() {
  local file
  local files=(
    stack
    compose.yaml
    compose.juno.yaml
    compose.provisioner.yaml
    compose.smoke.yaml
    config/Caddyfile
    scripts/juno-entrypoint.sh
    scripts/backup.sh
    scripts/mongo-init-app-user.sh
    scripts/mongo-entrypoint.sh
  )
  {
    compose --profile indexer --profile auditor --profile tools config --format json
    for file in "${files[@]}"; do
      printf '\0%s\0' "$file"
      command cat "${STACK_ROOT}/${file}"
    done
  } | openssl dgst -sha256 | awk '{ print $NF }'
}

record_integration_test() {
  local image="$1"
  local fingerprint="$2"
  local temporary
  mkdir -p "$STATE_DIR"
  chmod 700 "$STATE_DIR"
  temporary="$(mktemp "${INTEGRATION_RECEIPT}.XXXXXX")"
  printf 'image=%s\nfingerprint=%s\n' "$image" "$fingerprint" > "$temporary"
  chmod 600 "$temporary"
  mv "$temporary" "$INTEGRATION_RECEIPT"
}

require_integration_test() {
  local current_fingerprint
  local tested_fingerprint
  local tested_image
  [ -s "$INTEGRATION_RECEIPT" ] \
    || die "Run ./stack integration-test \"$INFLUENCE_SERVER_IMAGE\" before deploying"
  tested_image="$(awk -F= '$1 == "image" { sub(/^[^=]*=/, ""); print; exit }' "$INTEGRATION_RECEIPT")"
  tested_fingerprint="$(awk -F= '$1 == "fingerprint" { print $2; exit }' "$INTEGRATION_RECEIPT")"
  [ "$tested_image" = "$INFLUENCE_SERVER_IMAGE" ] \
    || die "The selected Influence server image has not passed this stack's integration test"
  current_fingerprint="$(deployment_fingerprint)"
  [ "$tested_fingerprint" = "$current_fingerprint" ] \
    || die "The stack configuration changed after its last integration test; run it again"
}

replace_env_value() {
  local key="$1"
  local value="$2"
  local temporary
  temporary="$(mktemp "${ENV_FILE}.XXXXXX")"
  awk -F= -v key="$key" -v value="$value" '
    BEGIN { OFS = "=" }
    $1 == key { print key, value; next }
    { print }
  ' "$ENV_FILE" > "$temporary"
  mv "$temporary" "$ENV_FILE"
}

ensure_env_from_example() {
  local key="$1"
  local example_value
  grep -q "^${key}=" "$ENV_FILE" && return 0
  grep -q "^${key}=" "${STACK_ROOT}/.env.example" \
    || die "Missing $key default in .env.example"
  example_value="$(awk -F= -v key="$key" '$1 == key { sub(/^[^=]*=/, ""); print; exit }' "${STACK_ROOT}/.env.example")"
  printf '%s=%s\n' "$key" "$example_value" >> "$ENV_FILE"
  export "$key=$example_value"
}

validate_data_root() {
  case "${DATA_ROOT:-}" in
    /*) ;;
    *) die "DATA_ROOT must be an absolute path" ;;
  esac
  [ "$DATA_ROOT" != "/" ] || die "DATA_ROOT cannot be /"
  [ "$DATA_ROOT" != "${HOME:-}" ] || die "DATA_ROOT cannot be the home directory"
}

file_permissions() {
  if stat -c '%a' "$1" >/dev/null 2>&1; then
    stat -c '%a' "$1"
  else
    stat -f '%Lp' "$1"
  fi
}

validate_juno_configuration() {
  [ -n "${JUNO_SNAPSHOT_URL:-}" ] || die "Configuration required: JUNO_SNAPSHOT_URL"
  validate_image_pin JUNO_IMAGE
  [[ "${JUNO_SNAPSHOT_EXPECTED_VERSION:-}" =~ ^v[0-9]+\.[0-9]+\.[0-9]+$ ]] \
    || die "JUNO_SNAPSHOT_EXPECTED_VERSION must be a stable release such as v0.16.6"
  [[ "${JUNO_IMAGE:-}" == *":${JUNO_SNAPSHOT_EXPECTED_VERSION}@sha256:"* ]] \
    || die "JUNO_IMAGE and JUNO_SNAPSHOT_EXPECTED_VERSION must pin the same release"
  [[ "${JUNO_PRUNE_RETAINED_BLOCKS:-128}" =~ ^[0-9]+$ ]] \
    || die "JUNO_PRUNE_RETAINED_BLOCKS must be a non-negative integer"
  [[ "${JUNO_PRUNE_MIN_AGE:-720h}" =~ ^([0-9]+)h$ ]] \
    || die "JUNO_PRUNE_MIN_AGE must be expressed as whole hours (for example, 720h)"
  (( BASH_REMATCH[1] >= 720 )) || die "JUNO_PRUNE_MIN_AGE must retain at least 720 hours"
  [[ "${JUNO_SNAPSHOT_EXTRACTION_RESERVE_GB:-200}" =~ ^[0-9]+$ ]] \
    || die "JUNO_SNAPSHOT_EXTRACTION_RESERVE_GB must be a non-negative integer"
  case "${JUNO_SNAPSHOT_KIND:-pruned}" in
    full|pruned) ;;
    *) die "JUNO_SNAPSHOT_KIND must be full or pruned" ;;
  esac

  validate_secret_file alchemy_juno_ethereum_ws_url || die "Invalid Juno credential"
  [[ "$(<"$(secret_file alchemy_juno_ethereum_ws_url)")" == wss://* ]] \
    || die "alchemy_juno_ethereum_ws_url must contain a wss:// URL"
}

validate_configuration() {
  validate_juno_configuration
  local invalid=0
  local variable
  local value
  for variable in API_DOMAIN CADDY_EMAIL CLIENT_URL IMAGES_SERVER_URL; do
    if [ -z "${!variable:-}" ] || [[ "${!variable}" == *example.com* ]] || [[ "${!variable}" == *replace-me* ]]; then
      echo "Configuration required: $variable" >&2
      invalid=1
    fi
  done

  for variable in INFLUENCE_SERVER_IMAGE CADDY_IMAGE MONGO_IMAGE REDIS_IMAGE \
    ELASTICSEARCH_IMAGE; do
    validate_image_pin "$variable"
  done

  for variable in MONGO_INITDB_ROOT_USERNAME MONGO_DATABASE MONGO_APP_USERNAME \
    MONGO_RESTORE_SOURCE_DATABASE; do
    value="${!variable:-}"
    case "$value" in
      ''|*[!A-Za-z0-9._~-]*) die "$variable contains unsupported characters" ;;
    esac
  done

  for variable in mongo_root_password mongo_app_password mongo_url redis_password redis_url \
    elasticsearch_password elasticsearch_url jwt_secret \
    alchemy_influence_ethereum_http_url; do
    validate_secret_file "$variable" || invalid=1
  done
  if [ -s "$(secret_file alchemy_influence_ethereum_http_url)" ] \
    && [[ "$(<"$(secret_file alchemy_influence_ethereum_http_url)")" != https://* ]]; then
    echo "alchemy_influence_ethereum_http_url must contain an https:// URL" >&2
    invalid=1
  fi

  if { [ "${STARTER_PACK_PROVISIONER_ENABLED:-0}" = "1" ] \
    || [ "${CREWMATE_PROVISIONER_ENABLED:-0}" = "1" ]; } \
    && [ "${ENABLE_PROVISIONER:-0}" != "1" ]; then
    die "A provisioner feature is enabled but ENABLE_PROVISIONER is not 1"
  fi

  if [ "${ENABLE_PROVISIONER:-0}" = "1" ]; then
    local key_path="${STARTER_PACK_PRIVATE_KEY_PATH:-/etc/influence/secrets/starter_pack_admin_private_key}"
    local key_permissions
    [ -s "$key_path" ] || die "Provisioner enabled but key file is missing or empty: $key_path"
    key_permissions="$(file_permissions "$key_path")"
    case "$key_permissions" in
      400|600) ;;
      *) die "Provisioner key must be readable only by its owner (mode 0400 or 0600): $key_path" ;;
    esac
    [ "${STARTER_PACK_PROVISIONER_ENABLED:-0}" = "1" ] \
      || [ "${CREWMATE_PROVISIONER_ENABLED:-0}" = "1" ] \
      || die "ENABLE_PROVISIONER=1 but no provisioner feature is enabled"

    [ -n "${STARKNET_STARTER_PACK_ADMIN:-}" ] \
      || { echo "Configuration required: STARKNET_STARTER_PACK_ADMIN" >&2; invalid=1; }
    validate_secret_file stripe_secret_key || invalid=1
    validate_secret_file stripe_webhook_secret || invalid=1
    if [ "${STARTER_PACK_PROVISIONER_ENABLED:-0}" = "1" ]; then
      for variable in STRIPE_STARTER_PACK_EXPLORER_PRODUCT_ID \
        STRIPE_STARTER_PACK_STRATEGIST_PRODUCT_ID STRIPE_STARTER_PACK_INDUSTRIALIST_PRODUCT_ID; do
        [ -n "${!variable:-}" ] || { echo "Configuration required: $variable" >&2; invalid=1; }
      done
    fi
    if [ "${CREWMATE_PROVISIONER_ENABLED:-0}" = "1" ]; then
      [ -n "${STRIPE_CREWMATE_PRODUCT_ID:-}" ] \
        || { echo "Configuration required: STRIPE_CREWMATE_PRODUCT_ID" >&2; invalid=1; }
    fi
  fi

  if [ "${AVNU_PAYMASTER_ENABLED:-0}" = "1" ]; then
    validate_secret_file avnu_paymaster_api_key || invalid=1
  fi

  if [ "${BANXA_CHECKOUT_ENABLED:-0}" = "1" ]; then
    [ -n "${BANXA_PARTNER_REF:-}" ] \
      || { echo "Configuration required: BANXA_PARTNER_REF" >&2; invalid=1; }
    validate_secret_file banxa_api_key || invalid=1
    validate_secret_file banxa_webhook_api_key || invalid=1
    validate_secret_file banxa_webhook_secret || invalid=1
  fi

  if [ "${NOTIFICATIONS_EMAIL_ENABLED:-0}" = "1" ]; then
    validate_secret_file sendgrid_api_key || invalid=1
  fi

  [ "$invalid" -eq 0 ] || die "Complete .env before deploying"
}

service_health() {
  local service="$1"
  local container_id
  container_id="$(compose ps -q "$service")"
  [ -n "$container_id" ] || return 1
  docker inspect --format '{{if .State.Health}}{{.State.Health.Status}}{{else}}{{.State.Status}}{{end}}' "$container_id"
}

wait_for_health() {
  local service="$1"
  local timeout="${2:-300}"
  local started_at="$SECONDS"
  local health
  info "Waiting for $service"
  while (( SECONDS - started_at < timeout )); do
    health="$(service_health "$service" 2>/dev/null || true)"
    if [ "$health" = "healthy" ] || [ "$health" = "running" ]; then
      return 0
    fi
    [ "$health" != "unhealthy" ] || die "$service became unhealthy"
    sleep 5
  done
  die "Timed out waiting for $service"
}

wait_for_required_workers() {
  local service
  for service in \
    influence-indexer \
    influence-ethereum-event-retriever \
    influence-starknet-event-retriever \
    influence-event-processor; do
    wait_for_health "$service" 600
  done
}

wait_for_required_application_health() {
  wait_for_required_workers
  wait_for_health influence-server 600
}

juno_rpc() {
  local method="$1"
  curl -fsS \
    -H 'content-type: application/json' \
    --data "{\"jsonrpc\":\"2.0\",\"id\":1,\"method\":\"${method}\",\"params\":[]}" \
    "http://127.0.0.1:${JUNO_HOST_PORT:-6060}/${JUNO_RPC_VERSION:-v0_8}"
}

juno_block() {
  juno_rpc starknet_blockNumber | jq -er '.result | if type == "string" then tonumber else . end'
}

juno_has_block() {
  local block="$1"
  curl -fsS \
    -H 'content-type: application/json' \
    --data "{\"jsonrpc\":\"2.0\",\"id\":1,\"method\":\"starknet_getBlockWithTxHashes\",\"params\":[{\"block_number\":${block}}]}" \
    "http://127.0.0.1:${JUNO_HOST_PORT:-6060}/${JUNO_RPC_VERSION:-v0_8}" \
    | jq -e --argjson block "$block" '.result.block_number == $block' >/dev/null
}

ethereum_block() {
  local result
  local provider
  provider="$(<"$(secret_file alchemy_influence_ethereum_http_url)")"
  result="$(curl -fsS \
    -H 'content-type: application/json' \
    --data '{"jsonrpc":"2.0","id":1,"method":"eth_blockNumber","params":[]}' \
    "$provider" | jq -er '.result')"
  printf '%d\n' "$((result))"
}

mongo_metrics() {
  local script
  script=$(cat <<'EOF'
require('module-alias/register');
require('@common/storage/db');
const { mongoose } = require('@common/storage/db');
const { EthereumBlockCache, StarknetBlockCache } = require('@common/lib/cache');
(async () => {
  const result = {
    ethereumCheckpoint: Number(await EthereumBlockCache.getLastRetrievedBlock()),
    starknetCheckpoint: Number(await StarknetBlockCache.getLastRetrievedBlock()),
    entities: await mongoose.model('Entity').estimatedDocumentCount(),
    packedLotCacheEntries: await mongoose.connection.collection('keyv')
      .countDocuments({ key: /^keyv:ASTEROID_LOTS_/ }),
    indexQueue: await mongoose.model('IndexItem').countDocuments({}),
    unprocessedEvents: await mongoose.model('Event').countDocuments({ lastProcessed: null, removed: { $ne: true } })
  };
  await mongoose.disconnect();
  // This one-off probe imports caches with their own persistent connections.
  // Write synchronously to bypass console logging and flush before terminating.
  require('fs').writeSync(1, `${JSON.stringify(result)}\n`);
  process.exit(0);
})().catch((error) => { console.error(error); process.exit(1); });
EOF
)
  compose --profile tools run --rm --no-deps influence-tools -e "$script" | tail -n 1
}

wait_for_juno() {
  local timeout="${JUNO_SYNC_TIMEOUT_SECONDS:-21600}"
  local started_at="$SECONDS"
  local syncing
  info "Waiting for Juno to finish snapshot migration and synchronize"
  while (( SECONDS - started_at < timeout )); do
    syncing="$(juno_rpc starknet_syncing 2>/dev/null | jq -c '.result' 2>/dev/null || true)"
    if [ "$syncing" = "false" ] \
      && curl -fsS "http://127.0.0.1:${JUNO_HOST_PORT:-6060}/ready/sync" >/dev/null 2>&1; then
      info "Juno synchronized at block $(juno_block)"
      return 0
    fi
    sleep 15
  done
  die "Timed out waiting for Juno synchronization"
}

juno_snapshot_headers() {
  curl --http1.1 -fsSIL --retry 5 --retry-delay 5 --connect-timeout 30 "$JUNO_SNAPSHOT_URL" \
    | awk '
      tolower($1) == "content-length:" { sub(/\r$/, "", $2); size=$2 }
      tolower($1) == "content-disposition:" {
        sub(/\r$/, ""); sub(/^[^:]*:/, "content-disposition:"); disposition=$0
      }
      END { print size; print disposition }'
}

download_juno_snapshot() {
  local destination="$1"
  local expected_headers="$2"
  local attempt
  local status
  for attempt in 1 2 3 4 5 6; do
    if [ "$attempt" -gt 1 ]; then
      [ "$(juno_snapshot_headers)" = "$expected_headers" ] \
        || die "Snapshot metadata changed during download; partial archive retained for inspection"
    fi
    # A fresh curl invocation recomputes the resume offset from the saved file.
    if curl --http1.1 -fL --retry 5 --retry-delay 5 --connect-timeout 30 \
      --speed-limit 1024 --speed-time 120 --continue-at - \
      --output "$destination" "$JUNO_SNAPSHOT_URL"; then
      return 0
    else
      status="$?"
    fi
    case "$status" in
      5|6|7|18|28|35|52|55|56|92) ;;
      *) return "$status" ;;
    esac
    [ "$attempt" -lt 6 ] || break
    info "Snapshot transfer interrupted (curl $status); resuming saved bytes in 5 seconds (attempt $((attempt + 1))/6)"
    sleep 5
  done
  return "$status"
}

install_juno_snapshot() {
  local juno_dir="${DATA_ROOT}/juno-data"
  local download_dir="${DATA_ROOT}/downloads"
  local archive="${download_dir}/juno-mainnet.tar.zst"
  local partial_metadata="${archive}.part.metadata"
  local headers
  local content_length
  local disposition
  local snapshot_identity
  local downloaded_bytes=0
  local available_kb
  local required_kb
  local reserve_gb="${JUNO_SNAPSHOT_EXTRACTION_RESERVE_GB:-200}"
  local stage
  local source_dir
  local items

  if [ -n "$(find "$juno_dir" -mindepth 1 -print -quit)" ]; then
    info "Using existing Juno data in $juno_dir"
    return 0
  fi

  info "Inspecting the Juno mainnet snapshot"
  headers="$(juno_snapshot_headers)"
  content_length="${headers%%$'\n'*}"
  disposition="${headers#*$'\n'}"
  [[ "$content_length" =~ ^[0-9]+$ ]] || die "Snapshot server did not provide a content length"
  [[ "$disposition" == *"${JUNO_SNAPSHOT_EXPECTED_VERSION:-v0.16.6}"* ]] \
    || die "Snapshot does not match JUNO_SNAPSHOT_EXPECTED_VERSION"
  case "${JUNO_SNAPSHOT_KIND:-pruned}:$disposition" in
    full:*_pruned_*) die "Expected a full Juno snapshot but the server returned a pruned snapshot" ;;
    pruned:*_pruned_*) ;;
    pruned:*) die "Expected a pruned Juno snapshot but the server returned a full snapshot" ;;
  esac

  snapshot_identity="${JUNO_SNAPSHOT_URL}|${content_length}|${disposition}"

  if [ -f "${archive}.part" ]; then
    if [ ! -f "$partial_metadata" ] || [ "$(<"$partial_metadata")" != "$snapshot_identity" ]; then
      die "Partial snapshot metadata no longer matches the upstream archive; remove the partial download before retrying"
    fi
    downloaded_bytes="$(wc -c < "${archive}.part")"
  else
    printf '%s\n' "$snapshot_identity" > "$partial_metadata"
  fi
  (( downloaded_bytes <= content_length )) || die "Partial snapshot is larger than the remote archive"
  available_kb="$(df -Pk "$DATA_ROOT" | awk 'NR == 2 { print $4 }')"
  required_kb="$(( (content_length - downloaded_bytes + 1023) / 1024 + reserve_gb * 1024 * 1024 ))"
  (( available_kb >= required_kb )) \
    || die "Insufficient free space for the snapshot download and extraction reserve"

  info "Downloading the Juno mainnet snapshot (resumable)"
  download_juno_snapshot "${archive}.part" "$headers"
  [ "$(wc -c < "${archive}.part")" -eq "$content_length" ] \
    || die "Downloaded snapshot size does not match the server metadata"
  mv "${archive}.part" "$archive"
  rm -f "$partial_metadata"

  if [ -n "${JUNO_SNAPSHOT_SHA256:-}" ]; then
    info "Verifying Juno snapshot checksum"
    printf '%s  %s\n' "$JUNO_SNAPSHOT_SHA256" "$archive" | sha256sum --check -
  else
    echo "Warning: JUNO_SNAPSHOT_SHA256 is unset; relying on TLS and Juno database validation." >&2
  fi

  stage="$(mktemp -d "${DATA_ROOT}/.juno-stage.XXXXXX")"
  info "Extracting the Juno snapshot"
  tar --use-compress-program=unzstd -xf "$archive" -C "$stage"

  source_dir="$stage"
  if [ -d "${stage}/juno_mainnet" ]; then
    source_dir="${stage}/juno_mainnet"
  elif [ -d "${stage}/juno_mainnet_pruned" ]; then
    source_dir="${stage}/juno_mainnet_pruned"
  fi

  shopt -s dotglob nullglob
  items=("${source_dir}"/*)
  shopt -u dotglob nullglob
  [ "${#items[@]}" -gt 0 ] || die "Juno snapshot extracted no database files"
  mv "${items[@]}" "$juno_dir/"
  rm -f "$archive"
  rm -rf -- "$stage"
}

restore_mongo() {
  local dump_path="$1"
  [ -f "$dump_path" ] || die "Mongo dump not found: $dump_path"
  dump_path="$(cd "$(dirname "$dump_path")" && pwd)/$(basename "$dump_path")"
  info "Restoring MongoDB from $(basename "$dump_path")"
  # The quoted script expands inside mongo-tools, not in this operator shell.
  # shellcheck disable=SC2016
  compose --profile tools run --rm --no-deps \
    --volume "${dump_path}:/restore/influence.archive:ro" \
    mongo-tools sh -ec '
      password="$(tr -d "\r\n" < /run/secrets/mongo_root_password)"
      uri="mongodb://${MONGO_INITDB_ROOT_USERNAME}:${password}@mongo:27017/?authSource=admin"
      mongorestore --uri="$uri" --archive=/restore/influence.archive --gzip --drop \
        --nsInclude="${MONGO_RESTORE_SOURCE_DATABASE}.*" \
        --nsFrom="${MONGO_RESTORE_SOURCE_DATABASE}.*" --nsTo="${MONGO_DATABASE}.*"
    '
}

reset_elasticsearch() {
  local indices
  local index
  # The quoted script expands inside Elasticsearch, not in this operator shell.
  # shellcheck disable=SC2016
  indices="$(compose exec -T elasticsearch sh -ec '
    password="$(tr -d "\r\n" < /run/secrets/elasticsearch_password)"
    curl -fsS -u "elastic:${password}" "http://localhost:9200/_cat/indices?h=index"
  ')"

  while IFS= read -r index; do
    [ -n "$index" ] || continue
    case "$index" in
      .*) continue ;;
      *[!A-Za-z0-9._-]*) die "Refusing to delete unexpected Elasticsearch index name: $index" ;;
    esac
    # The quoted script expands inside Elasticsearch, including the index argument.
    # shellcheck disable=SC2016
    compose exec -T elasticsearch sh -ec '
      password="$(tr -d "\r\n" < /run/secrets/elasticsearch_password)"
      curl -fsS -u "elastic:${password}" -X DELETE "http://localhost:9200/$1"
    ' sh "$index" >/dev/null
  done <<<"$indices"
}

wait_for_convergence() {
  local timeout="${INFLUENCE_CATCHUP_TIMEOUT_SECONDS:-21600}"
  local max_lag="${CATCHUP_MAX_LAG_BLOCKS:-20}"
  local started_at="$SECONDS"
  local metrics
  local ethereum_head
  local starknet_head
  local ethereum_checkpoint
  local starknet_checkpoint
  local queue
  local unprocessed
  local ethereum_lag
  local starknet_lag

  info "Waiting for Influence workers to catch up"
  while (( SECONDS - started_at < timeout )); do
    metrics="$(mongo_metrics 2>/dev/null || true)"
    ethereum_head="$(ethereum_block 2>/dev/null || true)"
    starknet_head="$(juno_block 2>/dev/null || true)"
    if [ -n "$metrics" ] && [ -n "$ethereum_head" ] && [ -n "$starknet_head" ] \
      && jq -e '[.ethereumCheckpoint, .starknetCheckpoint, .indexQueue, .unprocessedEvents]
        | all(type == "number")' <<<"$metrics" >/dev/null 2>&1; then
      ethereum_checkpoint="$(jq -r '.ethereumCheckpoint' <<<"$metrics")"
      starknet_checkpoint="$(jq -r '.starknetCheckpoint' <<<"$metrics")"
      queue="$(jq -r '.indexQueue' <<<"$metrics")"
      unprocessed="$(jq -r '.unprocessedEvents' <<<"$metrics")"
      ethereum_lag="$((ethereum_head - ethereum_checkpoint))"
      starknet_lag="$((starknet_head - starknet_checkpoint))"
      printf '    ethereum lag=%s, starknet lag=%s, events=%s, index queue=%s\n' \
        "$ethereum_lag" "$starknet_lag" "$unprocessed" "$queue"
      if (( ethereum_lag >= 0 && ethereum_lag <= max_lag \
        && starknet_lag >= 0 && starknet_lag <= max_lag \
        && unprocessed == 0 && queue == 0 )); then
        return 0
      fi
    fi
    sleep 15
  done
  die "Timed out waiting for Influence convergence"
}

