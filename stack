juno_container_image() {
  local container
  container="$(compose ps --all -q juno)"
  [ -n "$container" ] || return 1
  docker inspect --format '{{.Config.Image}}' "$container"
}

ensure_juno_image_applied() {
  local running_image
  if running_image="$(juno_container_image)" && [ "$running_image" != "$JUNO_IMAGE" ]; then
    die "Juno image pin changed; apply it separately with ./stack upgrade-juno"
  fi
}

maintain_juno() {
  local operation="$1"
  local stop_timeout="${JUNO_STOP_TIMEOUT_SECONDS:-300}"
  local running_image
  local metrics
  local checkpoint

  [ -s "${STATE_DIR}/bootstrap-complete" ] || die "Stack is not bootstrapped"
  require_command curl
  require_command docker
  require_command jq
  load_env
  validate_configuration
  compose_files
  [[ "$stop_timeout" =~ ^[1-9][0-9]*$ ]] \
    || die "JUNO_STOP_TIMEOUT_SECONDS must be a positive integer"
  running_image="$(juno_container_image)" || die "Juno container does not exist"

  case "$operation" in
    restart)
      [ "$running_image" = "$JUNO_IMAGE" ] \
        || die "Juno image pin changed; use ./stack upgrade-juno"
      ;;
    upgrade)
      [ "$running_image" != "$JUNO_IMAGE" ] \
        || die "Juno already uses the configured image; use ./stack restart-juno"
      info "Pulling the pinned Juno image before maintenance"
      compose pull juno
      "$0" backup
      ;;
    *) die "Unknown Juno maintenance operation: $operation" ;;
  esac

  metrics="$(mongo_metrics)" || die "Unable to read the saved Starknet checkpoint"
  checkpoint="$(jq -er '.starknetCheckpoint | select(type == "number" and . >= 0)' <<<"$metrics")" \
    || die "MongoDB does not contain a valid Starknet checkpoint"

  [ -n "$(compose --profile indexer ps -q influence-starknet-event-retriever)" ] \
    || die "The Starknet event retriever is not running"
  info "Stopping the Starknet event retriever at checkpoint $checkpoint"
  compose --profile indexer stop -t "$stop_timeout" influence-starknet-event-retriever
  info "Stopping Juno gracefully"
  compose stop -t "$stop_timeout" juno
  info "Starting Juno with the configured image"
  compose up -d --no-deps --force-recreate juno
  wait_for_juno

  if ! juno_has_block "$checkpoint"; then
    die "Juno does not retain checkpoint $checkpoint; the Starknet retriever remains stopped"
  fi

  info "Restarting the Starknet event retriever"
  compose --profile indexer up -d --no-deps influence-starknet-event-retriever
  info "Juno $operation completed at block $(juno_block)"
}

restart_juno() {
  [ "$#" -eq 0 ] || die "restart-juno takes no arguments"
  maintain_juno restart
}

upgrade_juno() {
  [ "$#" -eq 0 ] || die "upgrade-juno takes no arguments"
  maintain_juno upgrade
}

status_stack() {
  load_env
  compose_files
  compose --profile indexer --profile auditor ps
  echo
  if metrics="$(mongo_metrics 2>/dev/null)"; then
    echo "Influence convergence: $metrics"
  fi
  if block="$(juno_block 2>/dev/null)"; then
    echo "Juno block: $block"
  fi
}

logs_stack() {
  load_env
  compose_files
  if [ "$#" -gt 0 ]; then
    compose --profile indexer --profile auditor logs --follow "$1"
  else
    compose --profile indexer --profile auditor logs --follow
  fi
}

backup_stack() (
  load_env
  validate_data_root
  prepare_backup_repository
  require_command flock
  mkdir -p "$STATE_DIR"
  exec 9>"$STATE_DIR/backup.lock"
  flock -n 9 || die "Another backup is already running"
  # Check remote access before pausing production writers.
  backup_restic snapshots >/dev/null
  compose_files
  local output
  local staging
  umask 077
  staging="$(mktemp -d "${DATA_ROOT}/backups/pending.XXXXXX")"
  output="$staging/influence.archive"
  local backup_paths=("$output" "$ENV_FILE" "$STACK_ROOT/secrets" "$STACK_ROOT/config"
    "$STACK_ROOT/stack" "$STACK_ROOT/scripts" "$STACK_ROOT"/compose*.yaml)
  if [ "${ENABLE_PROVISIONER:-0}" = "1" ]; then
    local signer="${STARTER_PACK_PRIVATE_KEY_PATH:-/etc/influence/secrets/starter_pack_admin_private_key}"
    if [ ! -r "$signer" ] || [ ! -s "$signer" ]; then
      die "Cannot back up provisioner signer: $signer"
    fi
    backup_paths+=("$signer")
  fi
  local writers=(
    influence-server
    influence-indexer
    influence-ethereum-event-retriever
    influence-starknet-event-retriever
    influence-event-processor
    influence-event-auditor
    influence-agreement-auditor
  )
  local active_writers=()
  local writers_paused=0
  local writer
  for writer in "${writers[@]}"; do
    if [ -n "$(compose ps -q "$writer")" ]; then
      active_writers+=("$writer")
    fi
  done
  info "Creating $output"
  if [ "${#active_writers[@]}" -gt 0 ]; then
    info "Briefly pausing database writers for a consistent dump"
    writers_paused=1
    trap 'if [ "$writers_paused" -eq 1 ]; then compose --profile indexer --profile auditor unpause "${active_writers[@]}" || true; fi' EXIT
    trap 'exit 130' INT
    trap 'exit 143' TERM
    compose --profile indexer --profile auditor pause "${active_writers[@]}"
  fi
  # The quoted script expands inside mongo-tools; only the output filename is
  # intentionally inserted by the operator shell.
  # shellcheck disable=SC2016
  if ! compose --profile tools run --rm --no-deps \
    --user "$(id -u):$(id -g)" \
    --volume "${staging}:/backups" \
    mongo-tools sh -ec '
        password="$(tr -d "\r\n" < /run/secrets/mongo_root_password)"
        uri="mongodb://${MONGO_INITDB_ROOT_USERNAME}:${password}@mongo:27017/admin?authSource=admin"
        mongodump --uri="$uri" --db="$MONGO_DATABASE" --archive="/backups/'"$(basename "$output")"'" --gzip
      '; then
    die "MongoDB backup failed"
  fi
  chmod 600 "$output"
  if [ "${#active_writers[@]}" -gt 0 ]; then
    compose --profile indexer --profile auditor unpause "${active_writers[@]}"
    writers_paused=0
  fi
  trap - EXIT INT TERM
  if ! backup_restic backup --tag "$BACKUP_TAG" --host "$BACKUP_HOST" \
    --exclude "$(secret_file restic_password)" "${backup_paths[@]}"; then
    die "Off-host backup failed; local archive retained at $output"
  fi
  rm -- "$output"
  rmdir -- "$staging"
  backup_restic forget --tag "$BACKUP_TAG" --host "$BACKUP_HOST" --group-by host,tags \
    --keep-daily "$BACKUP_KEEP_DAILY" --keep-weekly "$BACKUP_KEEP_WEEKLY" --prune
  info "Encrypted off-host backup complete"
)

main() {
  local command="${1:-}"
  [ -n "$command" ] || { usage; exit 1; }
  shift
  case "$command" in
    init) init_stack "$@" ;;
    install-secret) install_secret "$@" ;;
    prepare-host) prepare_host "$@" ;;
    install-signer-key) install_signer_key "$@" ;;
    config) config_stack "$@" ;;
    integration-test) integration_test "$@" ;;
    prepare-juno) prepare_juno "$@" ;;
    bootstrap) bootstrap_stack "$@" ;;
    deploy) deploy_stack "$@" ;;
    update) update_stack "$@" ;;
    restart-juno) restart_juno "$@" ;;
    upgrade-juno) upgrade_juno "$@" ;;
    status) status_stack "$@" ;;
    logs) logs_stack "$@" ;;
    backup) backup_stack "$@" ;;
    backup-init) backup_repository init "$@" ;;
    backup-repository) backup_repository "$@" ;;
    help|-h|--help) usage ;;
    *) usage; die "Unknown command: $command" ;;
  esac
}

# shellcheck source=scripts/backup.sh
source "$STACK_ROOT/scripts/backup.sh"

if [[ "${BASH_SOURCE[0]}" == "$0" ]]; then
  main "$@"
fi
