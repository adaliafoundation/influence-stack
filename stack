install_secret() {
  if [ "$#" -lt 1 ] || [ "$#" -gt 2 ]; then
    die "Usage: ./stack install-secret NAME [PATH]"
  fi
  local name="$1"
  local source="${2:-}"
  local destination
  case "$name" in
    restic_password|alchemy_juno_ethereum_ws_url|alchemy_influence_ethereum_http_url|jwt_secret|\
    argent_api_key|ipfs_rpc_authorization|open_sea_api_key|\
    sendgrid_api_key|stripe_secret_key|stripe_webhook_secret|\
    avnu_paymaster_api_key|banxa_api_key|banxa_webhook_api_key|banxa_webhook_secret) ;;
    *) die "Unsupported secret name: $name" ;;
  esac
  destination="$(secret_file "$name")"
  mkdir -p "${STACK_ROOT}/secrets"
  chmod 700 "${STACK_ROOT}/secrets"
  umask 077
  if [ -n "$source" ]; then
    [ -s "$source" ] || die "Secret source is missing or empty: $source"
    [ "$source" != "$destination" ] || die "Secret is already installed"
    tr -d '\r\n' < "$source" > "${destination}.new"
  else
    local value
    read -r -s -p "Enter $name: " value
    echo
    printf '%s' "$value" > "${destination}.new"
  fi
  [ -s "${destination}.new" ] || die "Secret became empty after removing line endings"
  mv "${destination}.new" "$destination"
  chmod 600 "$destination"
  info "Installed secret: $name"
}

prepare_host() {
  load_env
  validate_data_root
  local owner_group
  owner_group="$(id -u):$(id -g)"
  info "Preparing persistent storage under $DATA_ROOT"
  sudo install -d -m 0750 -o "$(id -u)" -g "$(id -g)" \
    "$DATA_ROOT" "$DATA_ROOT/juno-data" "$DATA_ROOT/downloads" "$DATA_ROOT/backups"
  sudo install -d -m 0750 -o 999 -g 999 "$DATA_ROOT/mongodb-data" "$DATA_ROOT/redis-data"
  sudo install -d -m 0750 -o 1000 -g 0 "$DATA_ROOT/elasticsearch-data"
  sudo install -d -m 0750 -o 1000 -g 1000 "$DATA_ROOT/caddy-data" "$DATA_ROOT/caddy-config"
  sudo install -d -m 0700 -o "$(id -u)" -g "$(id -g)" /etc/influence/secrets
  printf '%s\n' 'vm.overcommit_memory=1' 'vm.max_map_count=262144' \
    | sudo tee /etc/sysctl.d/99-influence-stack.conf >/dev/null
  sudo sysctl --system >/dev/null
  info "Persistent storage ready (operator $owner_group)"
}

install_signer_key() {
  [ "$#" -eq 1 ] || die "Usage: ./stack install-signer-key /secure/path/private-key"
  local source="$1"
  local destination
  [ -s "$source" ] || die "Signer key source is missing or empty: $source"
  load_env
  destination="${STARTER_PACK_PRIVATE_KEY_PATH:-/etc/influence/secrets/starter_pack_admin_private_key}"
  case "$destination" in
    /*) ;;
    *) die "STARTER_PACK_PRIVATE_KEY_PATH must be absolute" ;;
  esac
  [ "$source" != "$destination" ] || die "Signer key is already at its destination"
  sudo install -d -m 0700 -o "$(id -u)" -g "$(id -g)" "$(dirname "$destination")"
  sudo install -m 0400 -o "$(id -u)" -g "$(id -g)" "$source" "$destination"
  info "Installed signer key at $destination"
}

